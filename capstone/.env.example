# Node
TZ=UTC
PORT=3333
HOST=localhost
NODE_ENV=development

# App
LOG_LEVEL=info
APP_KEY=
APP_URL=http://${HOST}:${PORT}

# Session
SESSION_DRIVER=cookie

# PostgreSQL (create this database before running migrations)
DB_HOST=127.0.0.1
DB_PORT=5432
DB_USER=postgres
DB_PASSWORD=change-me
DB_DATABASE=kadea_chat
DB_SSL=false

# Local messages are written to tmp/mail. Production must use resend.
MAIL_DRIVER=log
MAIL_FROM=Kadea Chat <chat@your-verified-domain.example>
RESEND_API_KEY=
# Absolute persistent directory in production (e.g. /data/uploads)
UPLOADS_PATH=

# Confirmation forwarding is for non-production tests only.
MAIL_TEST_MODE=false
# Must exactly match the email address of your Resend account.
# MAIL_TEST_RECIPIENT=developer@example.com
