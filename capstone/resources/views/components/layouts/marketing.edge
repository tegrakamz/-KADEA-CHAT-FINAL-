<!DOCTYPE html>
<html lang="fr" data-theme="light">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#FAFAF8" />
    <title>Kadea Chat · Échangez simplement</title>
    @vite(['resources/css/app.css', 'resources/js/app.js'])
    @stack('dumper')
  </head>
  <body class="marketing-body">
    <header class="marketing-header">
      @!logo({ size: 36 })
      <nav>
        @if(auth.user)
          @link({ route: 'dashboard', class: 'gold-button' })
            Aller aux messages
          @end
        @else
          @link({ route: 'session.create', class: 'marketing-login' })
            Connexion
          @end
          @link({ route: 'new_account.create', class: 'gold-button' })
            Créer un compte
          @end
        @end
      </nav>
    </header>
    {{{ await $slots.main() }}}
    @include('partials/flash_alerts')
  </body>
</html>
