@layouts.marketing()
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status mono tag" style="color: var(--subtle);">
          <span class="dot"></span>
          404
        </span>
      </div>
      <div class="pc-lead"><span>Page introuvable</span></div>
