@layouts.marketing()
  <div class="home">
    <article class="prose-card">
      <div class="pc-top">
        <span class="pc-status mono tag" style="color: #c0392b;">
          <span class="dot"></span>
          500
        </span>
      </div>
      <div class="pc-lead">
        <span>Le service est momentanément indisponible</span>
      </div>
      <p class="pc-para">
        Réessayez dans quelques instants. Si le problème persiste, contactez l’équipe Kadea Chat.
      </p>
      <a class="btn btn--primary" href="/">Retour à l’accueil</a>
    </article>
  </div>
@end
