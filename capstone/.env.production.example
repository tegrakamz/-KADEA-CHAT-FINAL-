NODE_ENV=production
HOST=0.0.0.0
PORT=3333
TZ=UTC
LOG_LEVEL=info
APP_KEY=replace-with-a-generated-key
APP_URL=https://your-public-domain.example
SESSION_DRIVER=cookie
DB_HOST=your-postgres-host
DB_PORT=5432
DB_USER=your-postgres-user
DB_PASSWORD=change-me
DB_DATABASE=kadea_chat
DB_SSL=true
# Optional certificate authority; encode newlines as \n if required by your host.
# DB_SSL_CA=
MAIL_DRIVER=resend
MAIL_FROM=Kadea Chat <chat@your-verified-domain.example>
RESEND_API_KEY=
UPLOADS_PATH=/data/uploads

# Confirmation forwarding is for non-production tests only.
MAIL_TEST_MODE=true
# Must exactly match the email address of your Resend account.
# MAIL_TEST_RECIPIENT=developer@example.com
